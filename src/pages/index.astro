---
import Base from '../layouts/Base.astro';
import { published, label } from '../lib';
const items = await published();
---
<Base>
  <p class="tagline">AI ideas tested on real systems: measured results, code included.</p>
  <ul class="list">
    {items.map((a) => (
      <li>
        <a href={`/articles/${a.id}/`}><strong>{label(a)}</strong></a>{a.data.draft && ' (draft)'}<br />
        <span class="muted">{a.data.date.toISOString().slice(0, 10)} — {a.data.description}</span>
      </li>
    ))}
  </ul>
  {items.length === 0 && <p class="muted">First article coming soon.</p>}
</Base>
