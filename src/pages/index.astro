---
import Base from '../layouts/Base.astro';
import { published } from '../lib';
const items = await published();
---
<Base>
  <div class="hero">
  <picture class="figure">
    <source srcset="/cycanic-full.webp" type="image/webp" />
    <img src="/cycanic-full.png" width="453" height="900" alt="cycanics: a red armoured cyborg mechanic with tools" />
  </picture>
  <div class="text">
  <p><strong>AI ideas tested on real systems: measured results, code included.</strong></p>
  <ul class="list">
    {items.map((a) => (
      <li>
        <a href={`/articles/${a.id}/`}><strong>{a.data.title}</strong></a>{a.data.draft && ' (draft)'}<br />
        <span class="muted">{a.data.date.toISOString().slice(0, 10)} — {a.data.description}</span>
      </li>
    ))}
  </ul>
  {items.length === 0 && <p class="muted">First article coming soon.</p>}
  </div>
  </div>
</Base>
